{
  "name": "decoder-ring",
  "version": "1.0.0",
  "description": "JavaScript application implementing Caesar, Polybius Square, and substitution ciphers with automated unit tests",
  "repository": {
    "type": "git",
    "url": "YOUR-ACTUAL-DECODER-RING-GITHUB-URL"
  },
  "scripts": {
    "docker:build": "docker image build . -t thinkful-ed/zid-pf-project-decoder-ring-01-qualified",
    "docker:run": "docker run --rm -it -p 3000:3000 thinkful-ed/zid-pf-project-decoder-ring-01-qualified",
    "docker:stop": "docker stop $(docker ps -q)",
    "docker:test": "docker run -t  thinkful-ed/zid-pf-project-decoder-ring-01-qualified npm test",
    "start": "live-server",
    "start:solution": "npm run -it docker:build && npm run docker:run",
    "test": "mocha",
    "test:solution": "npm run docker:build && npm run docker:test"
  },
  "keywords": ["javascript",
  "algorithms",
  "caesar-cipher",
  "polybius-square",
  "substitution-cipher",
  "mocha",
  "chai",
  "unit-testing"],
  "author": "Michael Brehm",
  "license": "ISC",
  "devDependencies": {
    "chai": "^4.3.7",
    "colors": "1.4.0",
    "live-server": "1.2.1",
    "mocha": "^8.4.0"
  }
}
